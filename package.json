		"typescript-eslint": "^8.72.0",
		"vite": "^4.0.0"
	},
	"type": "module",
	"dependencies": {
		"svelte-i18n": "^3.3.13",
		"svelte-select": "^4.4.7",
		"tailwindcss": "^3.0.24"
